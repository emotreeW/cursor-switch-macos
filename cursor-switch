#!/usr/bin/env python3
"""Switch Cursor accounts on macOS by swapping login rows in the default data dir.

Chat history stays in ~/Library/Application Support/Cursor. Only cursorAuth/*
and glass.lastSignedInAuthId are replaced. Cursor must fully quit before a
switch, or WAL replay will overwrite the write.

Unofficial. Cursor can change this storage in any release.
"""

from __future__ import annotations

import argparse
import json
import os
import sqlite3
import subprocess
import sys
import time
import fcntl
from datetime import datetime, timezone
from pathlib import Path
from urllib.parse import unquote, urlparse

HOME = Path.home()
DEFAULT_DATA_DIR = HOME / "Library/Application Support/Cursor"
PROPLUS_DATA_DIR = HOME / "Library/Application Support/Cursor-ProPlus"
STATE_REL = Path("User/globalStorage/state.vscdb")
STORE_DIR = HOME / ".config/cursor-switch"
ACCOUNTS_DIR = STORE_DIR / "accounts"
SYNC_DIR = STORE_DIR / "sync"
CURSOR_APP = Path("/Applications/Cursor.app")
CURSOR_BIN = CURSOR_APP / "Contents/MacOS/Cursor"
PROPLUS_EXT_DIR = HOME / ".cursor-proplus/extensions"
HEADER_CHUNK_PAD = 6
DEFAULT_SYNC_DAYS = 7
FALLBACK_SYNC_DAYS = 4
DEFAULT_MAX_MB = 80

AUTH_SQL = (
    "key LIKE 'cursorAuth/%' OR key = 'glass.lastSignedInAuthId'"
)


def state_db(data_dir: Path) -> Path:
    return data_dir / STATE_REL


def account_path(name: str) -> Path:
    if not name or "/" in name or name in (".", ".."):
        raise SystemExit(f"bad account name: {name!r}")
    return ACCOUNTS_DIR / f"{name}.json"


def connect(db_path: Path, readonly: bool) -> sqlite3.Connection:
    if not db_path.exists():
        raise SystemExit(f"state.vscdb not found: {db_path}")
    uri = db_path.as_uri()
    if readonly:
        con = sqlite3.connect(f"{uri}?mode=ro", uri=True, timeout=10)
    else:
        con = sqlite3.connect(str(db_path), timeout=30)
        con.execute("PRAGMA busy_timeout = 30000")
    con.row_factory = sqlite3.Row
    return con


def read_auth_rows(data_dir: Path) -> dict[str, str]:
    con = connect(state_db(data_dir), readonly=True)
    try:
        rows = con.execute(
            f"SELECT key, value FROM ItemTable WHERE {AUTH_SQL}"
        ).fetchall()
    finally:
        con.close()
    out: dict[str, str] = {}
    for row in rows:
        value = row["value"]
        if value is None:
            continue
        if isinstance(value, bytes):
            value = value.decode("utf-8")
        out[row["key"]] = value
    return out


def write_auth_rows(data_dir: Path, keys: dict[str, str]) -> None:
    db = state_db(data_dir)
    con = connect(db, readonly=False)
    try:
        con.execute("PRAGMA wal_checkpoint(TRUNCATE)")
        con.execute(f"DELETE FROM ItemTable WHERE {AUTH_SQL}")
        con.executemany(
            "INSERT INTO ItemTable (key, value) VALUES (?, ?)",
            list(keys.items()),
        )
        con.commit()
        con.execute("PRAGMA wal_checkpoint(TRUNCATE)")
        result = con.execute("PRAGMA integrity_check").fetchone()
        if not result or result[0] != "ok":
            raise SystemExit(f"integrity_check failed: {result}")
    finally:
        con.close()


def summarize(keys: dict[str, str]) -> dict[str, str]:
    return {
        "email": keys.get("cursorAuth/cachedEmail", ""),
        "membership": keys.get("cursorAuth/stripeMembershipType", ""),
        "status": keys.get("cursorAuth/stripeSubscriptionStatus", ""),
    }


def cursor_pids() -> list[int]:
    try:
        out = subprocess.check_output(
            ["pgrep", "-f", str(CURSOR_BIN)], text=True
        )
    except subprocess.CalledProcessError:
        return []
    pids = []
    for line in out.split():
        try:
            pids.append(int(line))
        except ValueError:
            continue
    return pids


def quit_cursor(timeout: float = 40.0) -> None:
    pids = cursor_pids()
    if not pids:
        return
    subprocess.run(
        ["osascript", "-e", 'tell application "Cursor" to quit'],
        check=False,
        capture_output=True,
    )
    deadline = time.time() + timeout
    force_after = time.time() + timeout / 2
    while time.time() < deadline:
        pids = cursor_pids()
        if not pids:
            return
        if time.time() > force_after:
            subprocess.run(["kill", "-9", *map(str, pids)], check=False)
            force_after = deadline + 1
        time.sleep(0.3)
    raise SystemExit(
        "Cursor did not quit. Close every Cursor window, then run again."
    )


def launch_default_cursor() -> None:
    subprocess.run(["open", "-a", "Cursor"], check=True)


def launch_proplus_cursor() -> None:
    subprocess.run(
        [
            "open",
            "-n",
            "-a",
            "Cursor",
            "--args",
            f"--user-data-dir={PROPLUS_DATA_DIR}",
            f"--extensions-dir={PROPLUS_EXT_DIR}",
            "--disable-updates",
        ],
        check=True,
    )


def classify_cursor_pid(pid: int) -> str:
    try:
        out = subprocess.check_output(
            ["ps", "-p", str(pid), "-o", "command="], text=True
        )
    except subprocess.CalledProcessError:
        return "unknown"
    if "Cursor-ProPlus" in out:
        return "proplus"
    return "default"


def pids_for(kind: str) -> list[int]:
    return [pid for pid in cursor_pids() if classify_cursor_pid(pid) == kind]


def data_dir_kind(data_dir: Path) -> str:
    resolved = data_dir.resolve()
    if resolved == PROPLUS_DATA_DIR.resolve():
        return "proplus"
    return "default"


def quit_kind(kind: str, timeout: float = 40.0) -> None:
    pids = pids_for(kind)
    if not pids:
        return
    subprocess.run(["kill", "-15", *map(str, pids)], check=False)
    deadline = time.time() + timeout
    force_after = time.time() + timeout / 2
    while time.time() < deadline:
        pids = pids_for(kind)
        if not pids:
            return
        if time.time() > force_after:
            subprocess.run(["kill", "-9", *map(str, pids)], check=False)
            force_after = deadline + 1
        time.sleep(0.3)
    raise SystemExit(
        f"{kind} Cursor did not quit. Close that window, then run again."
    )


def launch_kind(kind: str) -> None:
    if kind == "proplus":
        launch_proplus_cursor()
        return
    if pids_for("default"):
        return
    launch_default_cursor()


def acquire_sync_lock() -> int:
    SYNC_DIR.mkdir(parents=True, exist_ok=True)
    os.chmod(STORE_DIR, 0o700)
    lock_path = SYNC_DIR / "sync.lock"
    fd = os.open(str(lock_path), os.O_CREAT | os.O_RDWR, 0o600)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        os.close(fd)
        raise SystemExit("another sync is already running")
    os.write(fd, f"{os.getpid()}\n".encode())
    return fd


def release_sync_lock(fd: int) -> None:
    fcntl.flock(fd, fcntl.LOCK_UN)
    os.close(fd)


def folder_from_file_uri(uri: str) -> str:
    if not uri:
        return ""
    parsed = urlparse(uri)
    return unquote(parsed.path)


def workspace_id_for_folder(data_dir: Path, folder: Path) -> str | None:
    wanted = str(folder.expanduser().resolve())
    root = data_dir / "User" / "workspaceStorage"
    if not root.exists():
        return None
    for path in root.glob("*/workspace.json"):
        try:
            data = json.loads(path.read_text(encoding="utf-8"))
        except (OSError, json.JSONDecodeError):
            continue
        got = folder_from_file_uri(str(data.get("folder") or ""))
        if got == wanted or os.path.normpath(got) == wanted:
            return path.parent.name
    return None


def ensure_workspace_json(data_dir: Path, workspace_id: str, folder: Path) -> None:
    dest = data_dir / "User" / "workspaceStorage" / workspace_id
    dest.mkdir(parents=True, exist_ok=True)
    payload = {
        "folder": folder.expanduser().resolve().as_uri(),
    }
    path = dest / "workspace.json"
    if path.exists():
        return
    path.write_text(json.dumps(payload) + "\n", encoding="utf-8")


def header_name(value: str | bytes | None) -> str:
    if not value:
        return ""
    if isinstance(value, bytes):
        value = value.decode("utf-8", "replace")
    try:
        return str(json.loads(value).get("name") or "")
    except json.JSONDecodeError:
        return ""


def kv_get(con: sqlite3.Connection, key: str) -> bytes | str | None:
    row = con.execute(
        "SELECT value FROM cursorDiskKV WHERE key = ?", (key,)
    ).fetchone()
    if row is None:
        return None
    return row["value"]


def kv_len(con: sqlite3.Connection, key: str) -> int:
    row = con.execute(
        "SELECT length(value) AS n FROM cursorDiskKV WHERE key = ?", (key,)
    ).fetchone()
    return int(row["n"] or 0) if row else 0


def chunk_count_from_composer_data(raw: bytes | str | None) -> int:
    if raw is None:
        return 0
    if isinstance(raw, bytes):
        try:
            text = raw.decode("utf-8")
        except UnicodeDecodeError:
            return 0
    else:
        text = raw
    try:
        data = json.loads(text)
    except json.JSONDecodeError:
        return 0
    log = data.get("headerLog") or {}
    try:
        return int(log.get("chunkCount") or 0)
    except (TypeError, ValueError):
        return 0


def conv_header_key(composer_id: str, index: int) -> str:
    return f"composerConvHeaders:{composer_id}:{str(index).zfill(HEADER_CHUNK_PAD)}"


def extra_composer_keys(composer_id: str) -> list[str]:
    return [
        f"composerData:{composer_id}",
        f"composerDraft:{composer_id}",
        f"composerTranscriptHeightTail:{composer_id}",
        f"composerTranscriptHeightTailIde:{composer_id}",
    ]


def collect_chat_keys(
    con: sqlite3.Connection, composer_id: str
) -> list[tuple[str, bytes | str]]:
    out: list[tuple[str, bytes | str]] = []
    data = None
    for key in extra_composer_keys(composer_id):
        value = kv_get(con, key)
        if value is None:
            continue
        out.append((key, value))
        if key.startswith("composerData:"):
            data = value
    n_chunks = chunk_count_from_composer_data(data)
    for index in range(n_chunks):
        key = conv_header_key(composer_id, index)
        value = kv_get(con, key)
        if value is None:
            continue
        out.append((key, value))
    return out


def chat_payload_size(con: sqlite3.Connection, composer_id: str, header_value) -> int:
    size = len(header_value or "")
    data = kv_get(con, f"composerData:{composer_id}")
    if data is not None:
        size += len(data)
    n_chunks = chunk_count_from_composer_data(data)
    for index in range(n_chunks):
        size += kv_len(con, conv_header_key(composer_id, index))
    for key in extra_composer_keys(composer_id)[1:]:
        size += kv_len(con, key)
    return size


def list_workspace_chats(
    con: sqlite3.Connection, workspace_id: str
) -> list[sqlite3.Row]:
    return con.execute(
        """
        SELECT composerId, workspaceId, createdAt, lastUpdatedAt, isArchived,
               isSubagent, recency, checkpointAt, value, subagentTypeName
        FROM composerHeaders
        WHERE workspaceId = ?
          AND ifnull(isSubagent, 0) = 0
          AND ifnull(isArchived, 0) = 0
        ORDER BY lastUpdatedAt DESC
        """,
        (workspace_id,),
    ).fetchall()


def cutoff_ms(days: int) -> int:
    return int(time.time() * 1000) - days * 86400 * 1000


def pick_chats(
    con: sqlite3.Connection,
    rows: list[sqlite3.Row],
    days: int,
    max_bytes: int,
) -> tuple[list[sqlite3.Row], int, int]:
    used_days = days
    chosen = [row for row in rows if int(row["lastUpdatedAt"] or 0) >= cutoff_ms(days)]
    if not chosen and days != FALLBACK_SYNC_DAYS:
        used_days = FALLBACK_SYNC_DAYS
        chosen = [
            row
            for row in rows
            if int(row["lastUpdatedAt"] or 0) >= cutoff_ms(FALLBACK_SYNC_DAYS)
        ]
    sized: list[tuple[sqlite3.Row, int]] = []
    total = 0
    for row in chosen:
        nbytes = chat_payload_size(con, row["composerId"], row["value"])
        sized.append((row, nbytes))
        total += nbytes
    if total <= max_bytes:
        return [row for row, _ in sized], total, used_days
    sized.sort(key=lambda item: int(item[0]["lastUpdatedAt"] or 0), reverse=True)
    kept: list[sqlite3.Row] = []
    total = 0
    for row, nbytes in sized:
        if kept and total + nbytes > max_bytes:
            break
        kept.append(row)
        total += nbytes
    return kept, total, used_days


def dest_header_map(con: sqlite3.Connection, ids: list[str]) -> dict[str, int]:
    out: dict[str, int] = {}
    if not ids:
        return out
    qmarks = ",".join("?" * len(ids))
    rows = con.execute(
        f"SELECT composerId, lastUpdatedAt FROM composerHeaders WHERE composerId IN ({qmarks})",
        ids,
    ).fetchall()
    for row in rows:
        out[row["composerId"]] = int(row["lastUpdatedAt"] or 0)
    return out


def backup_dest_chats(
    dest_con: sqlite3.Connection, composer_ids: list[str]
) -> Path | None:
    if not composer_ids:
        return None
    stamp = datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ")
    path = SYNC_DIR / "backups" / f"{stamp}.json"
    path.parent.mkdir(parents=True, exist_ok=True)
    os.chmod(SYNC_DIR, 0o700)
    payload = []
    for composer_id in composer_ids:
        row = dest_con.execute(
            "SELECT * FROM composerHeaders WHERE composerId = ?",
            (composer_id,),
        ).fetchone()
        if row is None:
            continue
        keys = collect_chat_keys(dest_con, composer_id)
        encoded_keys = []
        for key, value in keys:
            if isinstance(value, bytes):
                encoded_keys.append({"key": key, "encoding": "latin1", "value": value.decode("latin1")})
            else:
                encoded_keys.append({"key": key, "encoding": "utf-8", "value": value})
        payload.append(
            {
                "header": {k: row[k] for k in row.keys()},
                "keys": encoded_keys,
            }
        )
    path.write_text(json.dumps(payload) + "\n", encoding="utf-8")
    os.chmod(path, 0o600)
    return path


def write_chats(
    dest_con: sqlite3.Connection,
    headers: list[dict],
    kv_rows: dict[str, list[tuple[str, bytes | str]]],
) -> None:
    dest_con.execute("PRAGMA busy_timeout = 30000")
    dest_con.execute("BEGIN IMMEDIATE")
    try:
        for row in headers:
            dest_con.execute(
                """
                INSERT INTO composerHeaders (
                    composerId, workspaceId, createdAt, lastUpdatedAt,
                    isArchived, isSubagent, recency, checkpointAt,
                    value, subagentTypeName
                ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
                ON CONFLICT(composerId) DO UPDATE SET
                    workspaceId=excluded.workspaceId,
                    createdAt=excluded.createdAt,
                    lastUpdatedAt=excluded.lastUpdatedAt,
                    isArchived=excluded.isArchived,
                    isSubagent=excluded.isSubagent,
                    recency=excluded.recency,
                    checkpointAt=excluded.checkpointAt,
                    value=excluded.value,
                    subagentTypeName=excluded.subagentTypeName
                """,
                (
                    row["composerId"],
                    row["workspaceId"],
                    row["createdAt"],
                    row["lastUpdatedAt"],
                    row["isArchived"],
                    row["isSubagent"],
                    row["recency"],
                    row["checkpointAt"],
                    row["value"],
                    row["subagentTypeName"],
                ),
            )
            composer_id = row["composerId"]
            data = None
            for key, value in kv_rows.get(composer_id, []):
                dest_con.execute(
                    "INSERT OR REPLACE INTO cursorDiskKV (key, value) VALUES (?, ?)",
                    (key, value),
                )
                if key.startswith("composerData:"):
                    data = value
            n_chunks = chunk_count_from_composer_data(data)
            for index in range(n_chunks, n_chunks + 40):
                dest_con.execute(
                    "DELETE FROM cursorDiskKV WHERE key = ?",
                    (conv_header_key(composer_id, index),),
                )
        dest_con.commit()
    except Exception:
        dest_con.rollback()
        raise
    dest_con.execute("PRAGMA wal_checkpoint(TRUNCATE)")
    result = dest_con.execute("PRAGMA integrity_check").fetchone()
    if not result or result[0] != "ok":
        raise SystemExit(f"integrity_check failed: {result}")


def cmd_sync_chats(args: argparse.Namespace) -> None:
    folder = Path(args.folder).expanduser().resolve()
    if not folder.exists():
        raise SystemExit(f"folder not found: {folder}")
    from_dir = Path(args.from_dir).expanduser().resolve()
    to_dir = Path(args.to_dir).expanduser().resolve()
    if from_dir == to_dir:
        raise SystemExit("source and destination data dirs are the same")
    src_kind = data_dir_kind(from_dir)
    dest_kind = data_dir_kind(to_dir)
    days = int(args.days)
    max_bytes = int(args.max_mb) * 1024 * 1024
    workspace_id = workspace_id_for_folder(from_dir, folder)
    if not workspace_id:
        raise SystemExit(f"no workspaceStorage entry for {folder} in {from_dir}")

    src = connect(state_db(from_dir), readonly=True)
    try:
        rows = list_workspace_chats(src, workspace_id)
        chosen, total, used_days = pick_chats(src, rows, days, max_bytes)
        if not chosen:
            raise SystemExit(
                f"no chats in this workspace from the last {days} days"
            )
        chosen_dicts = [{key: row[key] for key in row.keys()} for row in chosen]
        kv_rows = {
            item["composerId"]: collect_chat_keys(src, item["composerId"])
            for item in chosen_dicts
        }
    finally:
        src.close()
    chosen = chosen_dicts

    dest_running = bool(pids_for(dest_kind))
    dest_con_ro = connect(state_db(to_dir), readonly=True)
    try:
        existing = dest_header_map(
            dest_con_ro, [row["composerId"] for row in chosen]
        )
    finally:
        dest_con_ro.close()

    copy_rows = []
    skipped = []
    for row in chosen:
        dest_ts = existing.get(row["composerId"])
        if dest_ts is not None and dest_ts > int(row["lastUpdatedAt"] or 0):
            skipped.append(row)
            continue
        copy_rows.append(row)

    report = {
        "ok": True,
        "folder": str(folder),
        "workspaceId": workspace_id,
        "from": str(from_dir),
        "to": str(to_dir),
        "days": used_days,
        "bytes": total,
        "copy": len(copy_rows),
        "skipNewerOnDest": [
            {
                "id": row["composerId"],
                "name": header_name(row["value"]),
            }
            for row in skipped
        ],
        "names": [header_name(row["value"]) for row in copy_rows[:12]],
        "destRunning": dest_running,
        "dryRun": bool(args.dry_run),
    }
    if args.dry_run or not copy_rows:
        print(json.dumps(report, ensure_ascii=False))
        return

    lock_fd = acquire_sync_lock()
    try:
        if dest_running:
            print(f"quitting {dest_kind} Cursor only", file=sys.stderr, flush=True)
            quit_kind(dest_kind)
        ensure_workspace_json(to_dir, workspace_id, folder)
        dest = connect(state_db(to_dir), readonly=False)
        try:
            backup_dest_chats(dest, [row["composerId"] for row in copy_rows])
            write_chats(dest, copy_rows, kv_rows)
        finally:
            dest.close()
        print("copied, relaunching destination", file=sys.stderr, flush=True)
        launch_kind(dest_kind)
    finally:
        release_sync_lock(lock_fd)
    print(json.dumps(report, ensure_ascii=False))


def current_account_name(email: str) -> str | None:
    if not email or not ACCOUNTS_DIR.exists():
        return None
    for path in ACCOUNTS_DIR.glob("*.json"):
        data = json.loads(path.read_text(encoding="utf-8"))
        if data.get("email") == email:
            return data.get("name") or path.stem
    return None


def other_account_name(email: str) -> str:
    names = []
    if ACCOUNTS_DIR.exists():
        for path in sorted(ACCOUNTS_DIR.glob("*.json")):
            data = json.loads(path.read_text(encoding="utf-8"))
            name = data.get("name") or path.stem
            if data.get("email") == email:
                continue
            names.append(name)
    if len(names) == 1:
        return names[0]
    if not names:
        raise SystemExit("capture a second account first")
    raise SystemExit(f"pick an account: cursor-switch to <name>  (saved: {', '.join(names)})")


def cmd_status(args: argparse.Namespace) -> None:
    keys = read_auth_rows(DEFAULT_DATA_DIR)
    info = summarize(keys)
    name = current_account_name(info["email"])
    if getattr(args, "json", False):
        print(
            json.dumps(
                {
                    "email": info["email"],
                    "membership": info["membership"],
                    "status": info["status"],
                    "name": name,
                    "running": bool(cursor_pids()),
                }
            )
        )
        return
    print(f"data dir: {DEFAULT_DATA_DIR}")
    print(f"name:     {name or '(unsaved)'}")
    print(f"email:    {info['email'] or '(none)'}")
    print(f"plan:     {info['membership'] or '(unknown)'} {info['status']}".rstrip())
    print(f"running:  {'yes' if cursor_pids() else 'no'}")


def cmd_capture(args: argparse.Namespace) -> None:
    data_dir = Path(args.from_dir).expanduser() if args.from_dir else DEFAULT_DATA_DIR
    keys = read_auth_rows(data_dir)
    if "cursorAuth/accessToken" not in keys:
        raise SystemExit(f"no cursorAuth/accessToken in {data_dir}")
    ACCOUNTS_DIR.mkdir(parents=True, exist_ok=True)
    os.chmod(STORE_DIR, 0o700)
    os.chmod(ACCOUNTS_DIR, 0o700)
    payload = {
        "name": args.name,
        "captured_at": datetime.now(timezone.utc).isoformat(),
        "source": str(data_dir),
        **summarize(keys),
        "keys": keys,
    }
    path = account_path(args.name)
    path.write_text(json.dumps(payload, indent=2) + "\n", encoding="utf-8")
    os.chmod(path, 0o600)
    info = summarize(keys)
    print(f"saved {args.name}: {info['email']} ({info['membership']}) <- {data_dir}")


def cmd_list(_args: argparse.Namespace) -> None:
    if not ACCOUNTS_DIR.exists():
        print("no saved accounts")
        return
    files = sorted(ACCOUNTS_DIR.glob("*.json"))
    if not files:
        print("no saved accounts")
        return
    for path in files:
        data = json.loads(path.read_text(encoding="utf-8"))
        print(
            f"{data.get('name', path.stem):12}  "
            f"{data.get('email', ''):32}  "
            f"{data.get('membership', ''):12}  "
            f"{data.get('captured_at', '')}"
        )


def load_account(name: str) -> dict:
    path = account_path(name)
    if not path.exists():
        raise SystemExit(
            f"no saved account {name!r}. capture it first: cursor-switch capture {name}"
        )
    return json.loads(path.read_text(encoding="utf-8"))


def refresh_if_logged_in(name_guess: str | None) -> None:
    """Write the live default-DB session back onto the matching saved account."""
    try:
        live = read_auth_rows(DEFAULT_DATA_DIR)
    except SystemExit:
        return
    email = live.get("cursorAuth/cachedEmail", "")
    if not email:
        return
    target_name = name_guess
    if ACCOUNTS_DIR.exists():
        for path in ACCOUNTS_DIR.glob("*.json"):
            data = json.loads(path.read_text(encoding="utf-8"))
            if data.get("email") == email:
                target_name = data.get("name") or path.stem
                break
    if not target_name:
        return
    path = account_path(target_name)
    if not path.exists():
        return
    data = json.loads(path.read_text(encoding="utf-8"))
    data["captured_at"] = datetime.now(timezone.utc).isoformat()
    data["source"] = str(DEFAULT_DATA_DIR)
    data.update(summarize(live))
    data["keys"] = live
    path.write_text(json.dumps(data, indent=2) + "\n", encoding="utf-8")
    os.chmod(path, 0o600)
    print(f"refreshed saved session for {target_name} ({email})")


def switch_to(name: str) -> None:
    target = load_account(name)
    keys = target.get("keys") or {}
    if "cursorAuth/accessToken" not in keys:
        raise SystemExit(f"saved account {name!r} has no accessToken")
    refresh_if_logged_in(None)
    STORE_DIR.mkdir(parents=True, exist_ok=True)
    log_path = STORE_DIR / "last-switch.log"
    log_path.write_text(
        f"{datetime.now(timezone.utc).isoformat()} switching to {name} "
        f"{target.get('email')} ({target.get('membership')})\n",
        encoding="utf-8",
    )
    print(
        f"switching default Cursor to {target.get('email')} "
        f"({target.get('membership')})"
    )
    print("quitting Cursor (this window will close)")
    sys.stdout.flush()
    quit_cursor()
    write_auth_rows(DEFAULT_DATA_DIR, keys)
    launch_default_cursor()
    with log_path.open("a", encoding="utf-8") as fh:
        fh.write(f"{datetime.now(timezone.utc).isoformat()} relaunched as {name}\n")
    print("relaunched Cursor with the default data directory")


def cmd_to(args: argparse.Namespace) -> None:
    switch_to(args.name)


def cmd_toggle(_args: argparse.Namespace) -> None:
    live = read_auth_rows(DEFAULT_DATA_DIR)
    email = live.get("cursorAuth/cachedEmail", "")
    switch_to(other_account_name(email))


def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        prog="cursor-switch",
        description="Swap Cursor login in the default macOS data dir; keep chats.",
    )
    sub = p.add_subparsers(dest="cmd", required=True)

    s = sub.add_parser("status", help="show who the default Cursor data dir is signed in as")
    s.add_argument("--json", action="store_true")
    s.set_defaults(func=cmd_status)

    c = sub.add_parser("capture", help="save login rows from a Cursor data dir")
    c.add_argument("name")
    c.add_argument(
        "--from",
        dest="from_dir",
        default=None,
        help="Cursor --user-data-dir (default: Application Support/Cursor)",
    )
    c.set_defaults(func=cmd_capture)

    l = sub.add_parser("list", help="list saved accounts (email/plan only)")
    l.set_defaults(func=cmd_list)

    t = sub.add_parser("to", help="quit Cursor, write saved login into the default dir, relaunch")
    t.add_argument("name")
    t.set_defaults(func=cmd_to)

    g = sub.add_parser("toggle", help="quit Cursor and switch to the other saved account")
    g.set_defaults(func=cmd_toggle)

    y = sub.add_parser(
        "sync-chats",
        help="copy this workspace's recent chats into the other Cursor data dir",
    )
    y.add_argument("--from-dir", required=True)
    y.add_argument("--to-dir", required=True)
    y.add_argument("--folder", required=True)
    y.add_argument("--days", type=int, default=DEFAULT_SYNC_DAYS)
    y.add_argument("--max-mb", type=int, default=DEFAULT_MAX_MB)
    y.add_argument("--dry-run", action="store_true")
    y.set_defaults(func=cmd_sync_chats)

    return p


def main() -> None:
    if sys.platform != "darwin":
        raise SystemExit("this tool is for macOS")
    args = build_parser().parse_args()
    args.func(args)


if __name__ == "__main__":
    main()
