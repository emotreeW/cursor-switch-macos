{
  "name": "cursor-switch",
  "displayName": "Cursor Switch",
  "description": "Open the other Cursor account, sync this workspace's chats, switch login, and toggle DeepSeek.",
  "version": "0.0.6",
  "publisher": "emotreeW",
  "license": "MIT",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": ["Other"],
  "activationEvents": ["onStartupFinished"],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "cursorSwitch.menu",
        "title": "Account Menu",
        "category": "Cursor Switch"
      },
      {
        "command": "cursorSwitch.openOther",
        "title": "Open Other Window",
        "category": "Cursor Switch"
      },
      {
        "command": "cursorSwitch.toggle",
        "title": "Toggle Account",
        "category": "Cursor Switch"
      },
      {
        "command": "cursorSwitch.to.super",
        "title": "Switch to Super",
        "category": "Cursor Switch"
      },
      {
        "command": "cursorSwitch.to.proplus",
        "title": "Switch to Pro+",
        "category": "Cursor Switch"
      },
      {
        "command": "cursorSwitch.toggleDeepSeek",
        "title": "Toggle DeepSeek / Grok",
        "category": "Cursor Switch"
      },
      {
        "command": "cursorSwitch.syncChats",
        "title": "Sync This Workspace's Recent Chats",
        "category": "Cursor Switch"
      }
    ]
  }
}
